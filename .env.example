# =====================================================================
# DocuPedia — Variáveis de Ambiente
# Copie este arquivo para `.env.local` e preencha com suas credenciais.
# =====================================================================

# ---------------------------------------------------------------------
# Google Generative AI (Gemini) — usado pelo provider @ai-sdk/google
# Gere sua chave em: https://aistudio.google.com/app/apikey
# O provider lê automaticamente esta variável.
# ---------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=

# ---------------------------------------------------------------------
# URL pública do site (produção). Usada nos links de e-mail do Supabase
# (redefinição de senha). Sem isso, links podem apontar para deploys
# temporários da Vercel e retornar DEPLOYMENT_NOT_FOUND.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://docupedia-alpha.vercel.app

# ---------------------------------------------------------------------
# Supabase — autenticação (e-mail/senha) + persistência dos documentos.
# Encontre em: Project Settings > API.
# OBRIGATÓRIO: o login e a lista de PDFs por usuário dependem do Supabase.
# ---------------------------------------------------------------------
# URL pública do projeto
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (pública) — usada no navegador e no SSR para autenticação.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Key — SOMENTE no servidor. NUNCA exponha ao cliente.
# Usada pela rota de processamento para gravar o documento do usuário.
SUPABASE_SERVICE_ROLE_KEY=
